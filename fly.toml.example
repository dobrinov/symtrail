# Secrets are set via `fly secrets set`, never committed:
#   RAILS_MASTER_KEY
#   LITESTREAM_REPLICA_BUCKET, LITESTREAM_ACCESS_KEY_ID, LITESTREAM_SECRET_ACCESS_KEY
#     (verify the S3 credentials before setting these — the litestream puma
#      plugin shuts the web process down if the replication process dies)
#   SMTP credentials for the mail provider
app = "symtrail"
primary_region = "ams"

[build]

[env]
  SQLITE_DIR = "/data"
  SOLID_QUEUE_IN_PUMA = "true"
  APPLE_BUNDLE_ID = "com.symtrail.app"

[mounts]
  source = "symtrail_data"
  destination = "/data"

[http_service]
  internal_port = 3000
  force_https = true
  min_machines_running = 1

[checks.health]
  port = 3000
  type = "http"
  path = "/up"
