# Local development env — copy to .env (gitignored). EXPO_PUBLIC_* values are
# inlined into the JS bundle at build time; EAS builds get theirs from the
# `env` block of the matching profile in eas.json instead.

EXPO_PUBLIC_APP_ENV=development

# PostHog project API key for THIS environment (each environment has its own
# PostHog project). Leave empty to disable analytics entirely (no-op client).
EXPO_PUBLIC_POSTHOG_API_KEY=

# Optional; defaults to the EU cloud ingestion host.
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
